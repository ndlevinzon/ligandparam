// ffpopt / ligandparam environment defaults
//
// This file ships with the package and is the store of values the code reads.
// Edit a copy and point at it, or override single keys (preferred):
//
//   export FFPOPT_DEFAULTS=/path/to/my_env_defaults.json
//   export FFPOPT_FAST_WAVEFRONT=1
//
// Resolution: packaged file -> FFPOPT_DEFAULTS overlay -> per-key EXPORT
// (EXPORT always wins). Booleans: 1/true/yes/on vs 0/false/no/off.
//
// null means "leave to code policy" (model / --fast heuristics). A non-null
// value here is passed into the code even without an EXPORT.

{
  // --- Fast wavefront / parallelism ---------------------------------------
  // Cheap presets: GAU_LOOSE, maxiter=200, milder energy threshold (delta stays 10).
  // Same as lig-dihed-correct --fast.
  "FFPOPT_FAST_WAVEFRONT": false,

  // Force larger nested wavefront pools (depth) vs more concurrent bonds/frags.
  "FFPOPT_PREF_WF_DEPTH": false,
  "FFPOPT_PREF_WF_BREADTH": false,

  // Minimum cores kept per wavefront when splitting nproc with prefer-depth.
  "FFPOPT_MIN_WF_NPROC": 2,

  // ASE-first (skip geomeTRIC ladder). null = auto (sander always;
  // xtb / aimnet2 / qdpi2 under --fast). 1/0 to force.
  "FFPOPT_ASE_FIRST": null,

  // MM-relax then one HL opt per node. null = on under --fast for
  // xtb / aimnet2 / qdpi2 (not sander). 1/0 to force. Soft-dihed: k-ramp
  // on MM, then one restrained HL at the final k (no unconstrained hard IC).
  "FFPOPT_MM_THEN_HL": null,
  // Cheap engine: sander | gfnff. null = sander if parm7 exists, else GFN-FF.
  "FFPOPT_MM_THEN_HL_MODEL": null,

  // QDpi2 opt force terms: both | xtb | dp. null = xtb under --fast, else both.
  "FFPOPT_QDPI2_OPT": null,

  // Re-score xtb/dp-only QDpi2 opts with a full QDpi2 single-point.
  // null = on when opt components are not "both".
  "FFPOPT_QDPI2_REFINE": null,

  // Completed nodes between wavefront checkpoints. null = nproc (x4 if --fast).
  "FFPOPT_WF_CHECKPOINT_EVERY": null,

  // Drain-loop heartbeat while in-flight nodes produce no completions (sec).
  // 0 = disable. Stops a long hard-IC opt from looking like a hang.
  "FFPOPT_WF_HEARTBEAT_SEC": 60,

  // Kill a wavefront node (fork+SIGTERM) if its opt exceeds this many
  // seconds. The drain loop then marks it failed and can run a deferred
  // neighbor seed. 0 = disable. Linux only; DDM 280 deg hung for hours
  // in one unconstrained HL hard IC while siblings sat idle.
  "FFPOPT_WF_NODE_WALL_SEC": 300,

  // 1-D BFS re-expansion guards (cycle graph C_{360/delta}).
  // Max hard_significant_improve spawns per bin (0 = unlimited).
  "FFPOPT_WF_MAX_EXPAND": 3,
  // After the profile is filled, spawn only if dE >= factor * threshold.
  "FFPOPT_WF_COVERAGE_SPAWN_FACTOR": 4.0,
  // If the last N spawns used at most 2 bins, freeze that 2-cycle (0 = off).
  "FFPOPT_WF_PINGPONG_WINDOW": 8,

  // Revisit a 1-D bin whose stored min is this many kcal above the
  // discrete interpolant of its cycle neighbors (Laplacian spike), or
  // that failed. Seed from the lower neighbor; Kabsch-lerp both when
  // they agree. 0 kcal disables. DDM 240 deg was ~6 kcal above 230/250.
  "FFPOPT_WF_RESCUE_KCAL": 2.0,
  // Max rescue visits per bin (0 = off).
  "FFPOPT_WF_RESCUE_MAX": 2,

  // Write per-node pickles after successful opts. Failures always write.
  // null = off under --fast, on otherwise.
  "FFPOPT_WF_NODE_PICKLE": null,

  // Per-constraint / restraint summaries from GeomOpt.
  // null = off under --fast, on otherwise.
  "FFPOPT_GEOMOPT_VERBOSE": null,

  // Shorter geomeTRIC recovery ladder (primary -> loose -> soft-maxiter).
  // Also implied by --fast / FFPOPT_FAST_WAVEFRONT=1.
  "FFPOPT_GEOMOPT_FAST_RECOVERY": false,

  // --- Bond batching (fragment twist) -------------------------------------
  // Pack many rotatable bonds into sequential joint-twist batches.
  "FFPOPT_BOND_BATCH": true,
  // Fragments with at most this many fit bonds keep independent 1-D
  // wavefronts. Larger fragments switch to whole-ligand joint packing.
  "FFPOPT_MAX_BONDS_PER_TWIST": 2,
  // Whole-ligand (--whole-ligand) pack size, also used by fragments with
  // more than FFPOPT_MAX_BONDS_PER_TWIST rotors. MM still updates between
  // sequential batches when a cluster exceeds this cap.
  "FFPOPT_WHOLE_MAX_BONDS_PER_TWIST": 8,
  // Graph distance (bonds) at which two rotatable bonds are treated as coupled.
  "FFPOPT_BOND_COUPLE_RADIUS": 2,

  // --- GeomOpt / geomeTRIC ------------------------------------------------
  // Soft-accept ASE fmax (eV/Ang). null = max(3 * ase_opt_tol, 0.05).
  "FFPOPT_ASE_LOOSE_FMAX": null,
  // Stall watchdog for the legacy geomeTRIC subprocess (seconds). 0 = disable.
  "FFPOPT_GEOMETRIC_STALL_SEC": 1800,
  // Full traceback on GeomOpt fallback (otherwise one-line stderr).
  "FFPOPT_GEOMOPT_TRACEBACK": false,
  // Force the old geomeTRIC CLI subprocess instead of in-process.
  "FFPOPT_GEOMETRIC_SUBPROCESS": false,
  // Recovery ladder on GeomOptNotConvergedError (loose / alt coordsys / soft).
  "FFPOPT_GEOMOPT_ROBUST": true,
  // Last ladder rung: treat maxiter as success and keep the best frame.
  "FFPOPT_GEOMOPT_SOFT_MAXITER": true,
  // Abort opt if a covalent bond exceeds this multiple of Rcov_i+Rcov_j
  // (flying H/C). Typical C-H ~1.09 Ang; 1.8 x Rcov is ~1.9 Ang.
  "FFPOPT_GEOM_MAX_BOND_SCALE": 1.8,
  // Abort before stepping if the starting fmax exceeds this (eV/Ang).
  "FFPOPT_GEOM_EXPLODE_FMAX": 50.0,

  // --- ConfSearch / multi-centroid HL -------------------------------------
  // Conformer count at which RMS clustering uses the fast (align-to-first)
  // path. 0 = always legacy per-pair GetBestRMS.
  "FFPOPT_CONFSEARCH_RMS_FAST_N": 50,
  // Keep centroid-0 HL when Fourier RMSE (kcal) is at or below this; scan
  // extra ConfSearch starts only for jagged torsions. null = always scan all.
  "FFPOPT_CENTROID_FOURIER_MAX": 0.5,

  // Soft-dihedral k-doubling cap (kcal/mol/rad^2). After this, one hard-IC
  // opt starts from the last soft coordinates instead of the original seed.
  "FFPOPT_SOFT_DIHED_KMAX": 8000.0,
  // Abort k-doubling when |dphi| exceeds this (deg). Whole-ligand seeds
  // that lose the well (50 deg vs target 230) must not yank k to 1000.
  // 0 disables. Neighbor rescue reseeds from a 10 deg neighbor instead.
  "FFPOPT_SOFT_DIHED_LOST_WELL_DEG": 30.0,

  // --- Dihedral fit -------------------------------------------------------
  // Legacy GeomOpt-per-iteration fit (slow). Default is fixed-geometry lsq.
  "FFPOPT_DIHED_FIT_REOPT": false,
  // barrier | torsion | full. CLI --fit-mode / --fit-full still win.
  "FFPOPT_FIT_MODE": "barrier",
  // Amber-safety valve: last-ditch |PK| clip (kcal/mol). The model is ridge /
  // truncated SVD plus an energy-domain V(phi) barrier, not this box.
  "FFPOPT_DIHED_FC_MAX": 25.0,
  // Drop SVD modes with sigma < rel * sigma_max (identifiability).
  "FFPOPT_DIHED_SVD_REL": 1e-4,
  // Tikhonov lambda on ||K||^2. 0 = truncated SVD first; increased if the
  // reconstructed barrier exceeds the energy-domain limit.
  "FFPOPT_DIHED_RIDGE_LAMBDA": 0.0,
  // Reconstructed shape peak-to-peak <= alpha * data peak-to-peak.
  "FFPOPT_DIHED_BARRIER_ALPHA": 2.0,
  // Absolute V(phi) peak-to-peak ceiling on a dense 0-360 grid (kcal/mol).
  // 0 disables. Typical organic rotors are well below 30.
  "FFPOPT_DIHED_BARRIER_ABS": 30.0,
  // Nested n=1..nprim AIC; keep the smallest k within the AIC window.
  "FFPOPT_DIHED_NPRIM_SELECT": true,
  "FFPOPT_DIHED_AIC_WINDOW": 2.0,
  // Generic sp3-sp3 reject: if fitted Vptp still exceeds this (kcal), K=0
  // (residual is not a torsion; keep GAFF). 0 disables. Also the reject
  // rung for alkane / polar sp3. Does not change FFPOPT_DIHED_FC_MAX.
  "FFPOPT_DIHED_SP3_BARRIER_MAX": 20.0,
  // Alkane-like (c3/hc/h1/h2/h3/hx only): scale Vptp down to this (kcal)
  // when below the sp3 reject threshold. 0 disables.
  "FFPOPT_DIHED_ALKANE_BARRIER_MAX": 5.0,
  // C-OH / C-OS / C-N3 / C-N4 / thioether: scale Vptp to this (kcal)
  // when below the sp3 reject. 0 disables.
  "FFPOPT_DIHED_POLAR_SP3_BARRIER_MAX": 8.0,
  // Sulfate / phosphate (s4, s6, p4, p5 on the central bond): reject
  // (K=0) above this Vptp (kcal). Tighter than generic sp3 (1-4 heavy).
  "FFPOPT_DIHED_SULFATE_BARRIER_MAX": 10.0,
  // Sulfate / phosphate cap (kcal) when below the reject threshold.
  "FFPOPT_DIHED_SULFATE_BARRIER_CAP": 4.0,
  // lsq | lbfgsb | jax. CLI --fit-backend still wins.
  "FFPOPT_FIT_BACKEND": "lsq",
  // Amber 1-4 electrostatic / VDW scale (used when the CLI omits them).
  "FFPOPT_SCEE": 1.2,
  "FFPOPT_SCNB": 2.0,

  // --- tblite / GFN2-xTB SCF ----------------------------------------------
  "FFPOPT_XTB_MAX_ITER": 500,
  "FFPOPT_XTB_ETEMP": 500.0,
  "FFPOPT_XTB_MIXER_DAMPING": 0.25,
  // eeq (preferred) or sad. Unknown values are ignored by older tblite.
  "FFPOPT_XTB_GUESS": "eeq",

  // --- AIMNet2 -------------------------------------------------------------
  // Torch device for --model aimnet2. null = auto (cuda if available, else cpu).
  // On CPU-only HPC nodes set cpu (or CUDA_VISIBLE_DEVICES=-1).
    "FFPOPT_AIMNET_DEVICE": null,
  // Concurrent AIMNet2 processes per visible GPU (wavefront spawn workers).
  // 44 CPU workers on one GPU will OOM; default 4. Ignored on CPU.
  "FFPOPT_AIMNET_PER_GPU": 4,
  // Absolute AIMNet2 worker cap. null = n_gpu * FFPOPT_AIMNET_PER_GPU.
  "FFPOPT_AIMNET_WORKERS": null
}
